# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud > App settings > Secrets.
# Email (Gmail: enable 2-step verification, then create an "App password")
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USER = "your.address@gmail.com"
SMTP_PASSWORD = "your-16-char-app-password"
SMTP_FROM = "your.address@gmail.com"

# SMS (optional, Twilio)
TWILIO_SID = ""
TWILIO_TOKEN = ""
TWILIO_FROM = "+1xxxxxxxxxx"
